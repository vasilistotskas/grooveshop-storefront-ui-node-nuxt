{
  "name": "grooveshop-storefront-ui-node-nuxt",
  "version": "3.186.0",
  "description": "Grooveshop Storefront UI Node Nuxt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt.git"
  },
  "author": "vasilistotskas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt/issues"
  },
  "homepage": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt#readme",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "ncu -u && npm i && npm run build && npm run lint && npm run dev",
    "prepare": "node scripts/check-lockstep-deps.mjs && nuxt prepare && (npx skilld prepare || true)",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "serve": "serve dist/",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --cache",
    "typecheck": "nuxt typecheck",
    "cleanup": "nuxt cleanup",
    "analyze": "npx nuxt analyze",
    "test": "vitest run",
    "test:ci": "vitest run --project=unit --project=nuxt --coverage",
    "test:e2e": "vitest run --project=e2e",
    "test:coverage": "vitest run --coverage",
    "openapi-ts": "openapi-ts",
    "semantic-release": "semantic-release",
    "generate:schema": "node scripts/fetch-schema.mjs",
    "sync:schema": "node scripts/sync-schema-yml.mjs",
    "check:deps": "node scripts/check-lockstep-deps.mjs",
    "trivy-scan": "trivy fs . --severity HIGH,CRITICAL --skip-dirs node_modules,dist,.output,.nuxt --exit-code 1",
    "audit:visual": "node scripts/audit-visual.mjs"
  },
  "dependencies": {
    "@comark/nuxt": "^0.6.2",
    "@internationalized/date": "3.12.4",
    "@intlify/core": "11.4.10",
    "@intlify/core-base": "11.4.10",
    "@intlify/devtools-types": "11.4.10",
    "@intlify/message-compiler": "11.4.10",
    "@intlify/shared": "11.4.10",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.9",
    "@nuxt/ui": "4.11.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/leaflet": "1.3.2",
    "@nuxtjs/seo": "5.3.14",
    "@pinia/nuxt": "1.0.2",
    "@vueuse/nuxt": "14.4.0",
    "better-sqlite3": "12.11.1",
    "defu": "6.1.7",
    "evlog": "2.28.1",
    "h3": "1.15.11",
    "isomorphic-dompurify": "4.2.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lottie-web": "5.13.0",
    "magic-string": "1.2.3",
    "nuxt": "4.5.2",
    "nuxt-ai-ready": "2.2.0",
    "nuxt-auth-utils": "0.5.30",
    "ofetch": "1.5.1",
    "pinia": "4.0.3",
    "redis": "6.2.1",
    "rss": "1.2.2",
    "tailwindcss": "4.3.3",
    "ufo": "1.6.4",
    "unstorage": "1.17.5",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/ant-design": "1.2.9",
    "@iconify-json/fa-solid": "1.2.2",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/heroicons-outline": "1.2.1",
    "@iconify-json/heroicons-solid": "1.2.1",
    "@iconify-json/lucide": "1.2.130",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/unjs": "1.2.4",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/devtools": "3.4.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "4.3.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stripe/stripe-js": "9.15.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.5.0",
    "@types/rss": "0.0.32",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.5.0",
    "@vueuse/core": "14.4.0",
    "eslint": "10.10.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "happy-dom": "20.14.0",
    "playwright-core": "1.63.0",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "undici": "8.10.2",
    "vite": "8.2.2",
    "vite-plugin-eslint2": "5.3.0",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11",
    "yaml": "^2.9.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@12.3.4"
}
