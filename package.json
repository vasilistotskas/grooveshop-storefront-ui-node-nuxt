{
  "name": "grooveshop-storefront-ui-node-nuxt",
  "version": "3.361.0",
  "description": "Grooveshop Storefront UI Node Nuxt",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt.git"
  },
  "author": "vasilistotskas",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt/issues"
  },
  "homepage": "https://github.com/vasilistotskas/grooveshop-storefront-ui-node-nuxt#readme",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "ncu -u && npm i && npm run build && npm run lint && npm run dev",
    "prepare": "node scripts/check-lockstep-deps.mjs && nuxt prepare",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "serve": "serve dist/",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --cache --concurrency=auto",
    "typecheck": "nuxt typecheck",
    "cleanup": "nuxt cleanup",
    "analyze": "npx nuxt analyze",
    "test": "vitest run",
    "test:ci": "vitest run --project=unit --project=nuxt --coverage",
    "test:e2e": "vitest run --project=e2e",
    "test:coverage": "vitest run --coverage",
    "openapi-ts": "openapi-ts",
    "semantic-release": "semantic-release",
    "generate:schema": "node scripts/fetch-schema.mjs",
    "sync:schema": "node scripts/sync-schema-yml.mjs",
    "sync:allauth-schema": "node scripts/sync-allauth-schema.mjs",
    "generate:palettes": "node scripts/generate-tailwind-palettes.mjs",
    "check:deps": "node scripts/check-lockstep-deps.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "trivy-scan": "trivy fs . --severity HIGH,CRITICAL --skip-dirs node_modules,dist,.output,.nuxt --exit-code 1"
  },
  "dependencies": {
    "@comark/vue": "^0.9.2",
    "@iconify-json/circle-flags": "1.2.14",
    "@internationalized/date": "3.12.4",
    "@intlify/core": "11.4.23",
    "@intlify/core-base": "11.4.23",
    "@intlify/devtools-types": "11.4.23",
    "@intlify/message-compiler": "11.4.23",
    "@intlify/shared": "11.4.23",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.3",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.14",
    "@nuxt/ui": "4.13.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.1.0",
    "@pinia/nuxt": "1.0.3",
    "@protomaps/basemaps": "5.7.2",
    "@tanstack/charts": "1.5.0",
    "@vueuse/integrations": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "defu": "6.1.7",
    "evlog": "2.37.1",
    "h3": "1.15.11",
    "isomorphic-dompurify": "4.8.0",
    "magic-string": "1.4.5",
    "maplibre-gl": "6.19.0",
    "nuxt": "4.7.0",
    "nuxt-auth-utils": "0.6.2",
    "ofetch": "1.5.1",
    "pinia": "4.1.0",
    "redis": "6.4.0",
    "rss": "1.2.2",
    "sortablejs": "1.15.7",
    "tailwindcss": "4.3.5",
    "ufo": "1.6.4",
    "unstorage": "1.17.6",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23",
    "vue-router": "5.5.1",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/ant-design": "1.2.9",
    "@iconify-json/fa-solid": "1.2.2",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/heroicons-outline": "1.2.1",
    "@iconify-json/heroicons-solid": "1.2.1",
    "@iconify-json/lucide": "1.2.159",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/unjs": "1.2.4",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/devtools": "4.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/kit": "4.7.0",
    "@nuxt/schema": "4.7.0",
    "@nuxt/test-utils": "4.4.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@stripe/stripe-js": "9.17.0",
    "@types/node": "26.6.7",
    "@types/rss": "0.0.32",
    "@types/sortablejs": "1.15.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/test-utils": "2.6.0",
    "@vueuse/core": "14.4.0",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "happy-dom": "21.0.4",
    "hookable": "5.5.3",
    "semantic-release": "25.0.9",
    "site-config-stack": "5.0.4",
    "typescript": "6.0.3",
    "undici": "8.13.1",
    "unimport": "7.0.3",
    "vite": "8.3.8",
    "vite-plugin-eslint2": "5.3.0",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14",
    "yaml": "^2.9.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@12.23.0"
}
