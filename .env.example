# App Configuration
NUXT_API_BASE_URL="http://localhost:8000/api/v1"
NUXT_MEDIA_STREAM_PATH="http://localhost:3003/media_stream-image"
NUXT_CACHE_BASE="redis"
NUXT_DJANGO_URL="http://localhost:8000"
NUXT_REDIS_HOST="localhost"
NUXT_REDIS_PORT="6379"
NUXT_REDIS_TTL="30"
# Redis DB allocation: 0=Django, 2=media-stream, 3=Nuxt (default)
NUXT_REDIS_DB="3"

# Authentication
#
# The encrypted nuxt-auth-utils session cookie is intentionally host-only
# (no configurable cookie domain) — that's the multi-tenant-correct
# behavior. Wiring a shared/apex cookie domain would leak carts/sessions
# across subdomain tenants.
NUXT_OAUTH_DISCORD_CLIENT_ID="XXXXXXXX"
NUXT_OAUTH_DISCORD_CLIENT_SECRET="XXXXXXXX"
NUXT_OAUTH_FACEBOOK_CLIENT_ID="XXXXXXXX"
NUXT_OAUTH_FACEBOOK_CLIENT_SECRET="XXXXXXXX"
NUXT_OAUTH_GITHUB_CLIENT_ID="XXXXXXXX"
NUXT_OAUTH_GITHUB_CLIENT_SECRET="XXXXXXXX"
NUXT_OAUTH_GOOGLE_CLIENT_ID="XXXXXXXX"
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="XXXXXXXX"
NUXT_SESSION_PASSWORD="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Author Information
NUXT_PUBLIC_AUTHOR_NAME="vasilistotskas"

# Info
NUXT_PUBLIC_APP_LOGO="http://localhost:3000/img/logo-navbar.png"
NUXT_PUBLIC_APP_TITLE="GrooveShop - APP TITLE"
NUXT_PUBLIC_DOMAIN_VERIFY_ID="domain-verify-id"
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google-site-verification"
NUXT_PUBLIC_ENVIRONMENT="development"

# Public Configuration
NUXT_PUBLIC_BASE_URL="http://localhost:3000"
NUXT_PUBLIC_DJANGO_HOST_NAME="localhost:8000"
NUXT_PUBLIC_DJANGO_URL="http://localhost:8000"
NUXT_PUBLIC_I18N_BASE_URL="http://localhost:3000"
NUXT_PUBLIC_MEDIA_STREAM_ORIGIN="http://localhost:3003"
NUXT_PUBLIC_MEDIA_STREAM_PATH="http://localhost:3003/media_stream-image"
NUXT_PUBLIC_STATIC_ORIGIN="http://localhost:8000"
NUXT_PUBLIC_TITLE_SEPARATOR="-"
NUXT_PUBLIC_GOOGLE_GSI_ENABLE="false"

# Site Configuration
NUXT_SITE_DEFAULT_LOCALE="el"
NUXT_SITE_DESCRIPTION="GrooveShop SITE DESCRIPTION"
NUXT_SITE_NAME="GrooveShop"
NUXT_SITE_URL="http://localhost:3000"

# Coveralls
COVERALLS_REPO_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
